# Telegram API credentials (from my.telegram.org)
API_ID=your_api_id_here
API_HASH=your_api_hash_here

# Main Bot Token (from @BotFather)
BOT_TOKEN=your_main_bot_token_here

# Logger Bot Token (from @BotFather)
LOGGER_BOT_TOKEN=your_logger_bot_token_here

# Owner/Admin Telegram User ID (numeric)
ADMIN_ID=your_telegram_id_here

# Encryption Key (Fernet 32-byte url-safe base64 string)
# Leave empty to generate automatically on first run
ENCRYPTION_KEY=

# MongoDB Connection String (MongoDB Atlas or Railway MongoDB plugin)
MONGO_URI=mongodb+srv://...

# Permanent Group Folder Link
PERMANENT_GROUP_FOLDER=https://t.me/addlist/Qt31BHYkGgk2MGFl
